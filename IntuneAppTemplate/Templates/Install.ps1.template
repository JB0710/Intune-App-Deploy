<#
.SYNOPSIS
    Intune Win32 app - INSTALL script.

.DESCRIPTION
    Installs the .exe or .msi found next to this script, silently, system-wide.
    MSI files run through msiexec /i; EXE files run with the switches below.
    - Skips the install if the same or a newer version is already installed.
    - Verifies the app appears in Add/Remove Programs afterwards.
    - On success, deletes the installer from the Intune content cache (IMECache).
    Log: C:\ProgramData\Microsoft\IntuneManagementExtension\Logs\<AppName>-Install.log
    (collected automatically by Intune "Collect diagnostics").

.NOTES
    Intune install command:
        powershell.exe -ExecutionPolicy Bypass -NoProfile -WindowStyle Hidden -File .\Install-__APPNAME__.ps1
    Exit codes: 0 = success, 3010 = success/reboot required, 1618 = retry (another install running), 1 = failure

    Generated by New-IntuneApp.ps1 from Templates\Install.ps1.template - re-run New-IntuneApp.ps1 rather than editing by hand.
#>

#region ---------------- App configuration (edit per app) ----------------
$AppName          = '__APPNAME__'                    # Used for log file names
$DisplayName      = '__DISPLAYNAME__'  # DisplayName in Add/Remove Programs (-like pattern, wildcards allowed)
$InstallerFilter  = '__INSTALLERFILTER__'                         # Installer file in the package root
$InstallArgs      = '__INSTALLARGS__'
$InstallLogArg    = '__INSTALLLOGARG__'                    # Installer log switch ({0} = log path). Set to '' if the installer has none.
$ProcessesToClose = __PROCESSES__                       # Process names (no .exe) to close before installing
$CleanupSource    = $true                           # Delete installer after a successful install
$CleanupOnlyInIMECache = $true                      # Safety: only clean up when running from Intune's IMECache
#endregion ------------------------------------------------------------------

# Relaunch in 64-bit PowerShell if Intune started us as 32-bit (avoids registry/Program Files redirection)
if ($env:PROCESSOR_ARCHITEW6432 -eq 'AMD64' -and -not [Environment]::Is64BitProcess) {
    & "$env:WINDIR\SysNative\WindowsPowerShell\v1.0\powershell.exe" -ExecutionPolicy Bypass -NoProfile -File $PSCommandPath
    exit $LASTEXITCODE
}

#region ---------------- Helpers ----------------
$LogDir = "$env:ProgramData\Microsoft\IntuneManagementExtension\Logs"
if (-not (Test-Path $LogDir)) { New-Item -Path $LogDir -ItemType Directory -Force | Out-Null }
$LogFile  = Join-Path $LogDir "$AppName-Install.log"
$SetupLog = Join-Path $LogDir "$AppName-Install-Setup.log"

function Write-Log {
    param([string]$Message, [ValidateSet('INFO','WARN','ERROR')][string]$Level = 'INFO')
    $line = '{0} [{1}] {2}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'), $Level, $Message
    Add-Content -Path $LogFile -Value $line
    Write-Host $line
}

function ConvertTo-Version {
    # Extracts the first dotted number and pads to 4 parts, so 8.9.8 and 8.9.8.0 compare as equal
    param([string]$Text)
    if ($Text -match '(\d+(\.\d+){1,3})') {
        $parts = [System.Collections.Generic.List[string]]$Matches[1].Split('.')
        while ($parts.Count -lt 4) { $parts.Add('0') }
        return [version]($parts -join '.')
    }
    return $null
}

function Get-MsiProperty {
    # Reads a value from an MSI's Property table (ProductVersion, ProductName, ProductCode, ...)
    param([string]$Path, [string]$Property)
    $installer = $db = $view = $record = $null
    try {
        $installer = New-Object -ComObject WindowsInstaller.Installer
        $db     = $installer.GetType().InvokeMember('OpenDatabase', 'InvokeMethod', $null, $installer, @($Path, 0))
        $view   = $db.GetType().InvokeMember('OpenView', 'InvokeMethod', $null, $db, @("SELECT Value FROM Property WHERE Property='$Property'"))
        [void]$view.GetType().InvokeMember('Execute', 'InvokeMethod', $null, $view, $null)
        $record = $view.GetType().InvokeMember('Fetch', 'InvokeMethod', $null, $view, $null)
        $value  = if ($record) { $record.GetType().InvokeMember('StringData', 'GetProperty', $null, $record, 1) } else { $null }
        [void]$view.GetType().InvokeMember('Close', 'InvokeMethod', $null, $view, $null)
        return $value
    }
    catch { return $null }
    finally {
        # Release the COM objects so the .msi isn't left locked (needed for source cleanup)
        foreach ($o in $record, $view, $db, $installer) { if ($o) { [void][System.Runtime.InteropServices.Marshal]::ReleaseComObject($o) } }
        [GC]::Collect(); [GC]::WaitForPendingFinalizers()
    }
}

function Get-InstalledApp {
    $paths = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
             'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
    Get-ItemProperty -Path $paths -ErrorAction SilentlyContinue |
        Where-Object { $_.DisplayName -like $DisplayName } |
        Select-Object -First 1
}

function Stop-AppProcess {
    foreach ($name in $ProcessesToClose) {
        Get-Process -Name $name -ErrorAction SilentlyContinue | ForEach-Object {
            Write-Log "Closing $($_.ProcessName) (PID $($_.Id))"
            $_ | Stop-Process -Force -ErrorAction SilentlyContinue
        }
    }
}

function Remove-SourceFiles {
    if (-not $CleanupSource) { return }
    if ($CleanupOnlyInIMECache -and $PSScriptRoot -notlike '*\IMECache\*') {
        Write-Log "Not running from IMECache ($PSScriptRoot) - skipping source cleanup."
        return
    }
    Get-ChildItem -Path $PSScriptRoot -File | Where-Object { $_.Extension -ne '.ps1' } | ForEach-Object {
        try   { Remove-Item -Path $_.FullName -Force -ErrorAction Stop; Write-Log "Removed source file: $($_.Name)" }
        catch { Write-Log "Could not remove $($_.Name): $($_.Exception.Message)" 'WARN' }
    }
}
#endregion -------------------------------------------

try {
    Write-Log "===== $AppName install started (running from $PSScriptRoot) ====="

    $Installer = Get-ChildItem -Path $PSScriptRoot -Filter $InstallerFilter -File | Select-Object -First 1
    if (-not $Installer) { throw "No installer matching '$InstallerFilter' found in $PSScriptRoot" }

    $IsMsi = $Installer.Extension -eq '.msi'
    if ($IsMsi) {
        # MSI: ProductVersion from the MSI itself (same value Windows shows as DisplayVersion)
        $TargetVersion = ConvertTo-Version (Get-MsiProperty -Path $Installer.FullName -Property 'ProductVersion')
    }
    else {
        # EXE: FileVersion first (numeric/standard)
        $TargetVersion = ConvertTo-Version $Installer.VersionInfo.FileVersion
    }
    if (-not $TargetVersion) { $TargetVersion = ConvertTo-Version $Installer.BaseName }
    if (-not $TargetVersion -and -not $IsMsi) { $TargetVersion = ConvertTo-Version $Installer.VersionInfo.ProductVersion }
    Write-Log "Installer: $($Installer.Name)  Version: $TargetVersion"

    $Existing = Get-InstalledApp
    if ($Existing) {
        $ExistingVersion = ConvertTo-Version $Existing.DisplayVersion
        Write-Log "Found installed: $($Existing.DisplayName) $ExistingVersion"
        if ($TargetVersion -and $ExistingVersion -and $ExistingVersion -ge $TargetVersion) {
            Write-Log 'Same or newer version already installed - nothing to do.'
            Remove-SourceFiles
            exit 0
        }
    }

    Stop-AppProcess

    if ($IsMsi) {
        $FilePath  = "$env:WINDIR\System32\msiexec.exe"
        $Arguments = "/i `"$($Installer.FullName)`" $InstallArgs"
    }
    else {
        $FilePath  = $Installer.FullName
        $Arguments = $InstallArgs
    }
    if ($InstallLogArg) { $Arguments = "$Arguments $($InstallLogArg -f $SetupLog)" }
    Write-Log "Running: `"$FilePath`" $Arguments"

    # WorkingDirectory = package folder, so relative paths (e.g. TRANSFORMS="app.mst") resolve
    $Process  = Start-Process -FilePath $FilePath -ArgumentList $Arguments -WorkingDirectory $PSScriptRoot -Wait -PassThru -WindowStyle Hidden
    $ExitCode = $Process.ExitCode
    Write-Log "Installer exit code: $ExitCode"
    if ($ExitCode -eq 1618) { Write-Log 'Another installation is in progress (1618) - Intune will retry.' 'WARN'; exit 1618 }
    if ($ExitCode -notin 0, 1641, 3010) { throw "Installer failed with exit code $ExitCode" }

    # Verify
    $Installed = $null
    for ($i = 0; $i -lt 12 -and -not $Installed; $i++) { Start-Sleep -Seconds 5; $Installed = Get-InstalledApp }
    if (-not $Installed) { throw "Installer returned $ExitCode but '$DisplayName' was not found in Add/Remove Programs." }
    Write-Log "Verified installed: $($Installed.DisplayName) $($Installed.DisplayVersion)"

    Remove-SourceFiles

    if ($ExitCode -in 1641, 3010) { Write-Log 'Reboot required.'; exit 3010 }
    Write-Log "===== $AppName install completed successfully ====="
    exit 0
}
catch {
    Write-Log $_.Exception.Message 'ERROR'
    Write-Log "===== $AppName install FAILED =====" 'ERROR'
    exit 1
}
