# Installers are downloaded from Source/download.json - never commit them (GitHub rejects files over 100 MB)
*/Source/*.exe
*/Source/*.msi
*/Source/*.msp
*/Source/*.zip

# Build output
*/Output/*
!*/Output/.gitkeep

# Credentials - never commit
*.pfx
*.p12
*.cer
*.key
INTUNE_*.txt
IntuneAutomationCredentials/

# Local upload logs (CI writes results to the job summary instead)
*/Documentation/*-IntuneUploads.log

# Self-hosted runner - install it OUTSIDE the repository (it holds the runner's credentials)
actions-runner/
_work/

# Temporary copy of the updated workflows
github-workflows-fixed/
